# Audio Splitter — Environment Variables
# Copy this file to .env and adjust values as needed.
# All variables are optional; defaults are shown.

# Maximum accepted upload size in MB. Requests exceeding this are rejected with HTTP 413.
MAX_FILE_SIZE_MB=500

# Maximum time in seconds for FFmpeg split operations before killing the process.
FFMPEG_TIMEOUT_SECONDS=300

# Maximum time in seconds for ffprobe metadata queries and readiness checks.
FFPROBE_TIMEOUT_SECONDS=30

# Minimum allowed value for the chunk_size_mb request parameter.
CHUNK_SIZE_MB_MIN=0.1

# Maximum allowed value for the chunk_size_mb request parameter.
CHUNK_SIZE_MB_MAX=500

# Maximum number of output chunks allowed per request. Requests that would exceed
# this limit are rejected with HTTP 400.
MAX_CHUNKS=1000
