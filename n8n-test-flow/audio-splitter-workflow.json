      "parameters": {
        "jsCode": "const items = [];\nconst input = $input.first().json;\n\n// Split by newlines to get individual JSON objects\nconst lines = input.data.split('\\n').filter(line => line.trim().length > 0);\n\nconsole.log(`Found ${lines.length} JSON objects to parse`);\n\nfor (let i = 0; i < lines.length; i++) {\n  let chunk;\n  try {\n    chunk = JSON.parse(lines[i]);\n  } catch (error) {\n    console.error(`Failed to parse line ${i}:`, error.message);\n    console.error(`Line content:`, lines[i].substring(0, 200));\n    continue;\n  }\n  \n  // Validate structure\n  if (!chunk.binary || !chunk.binary.data || !chunk.binary.data.data) {\n    console.error(`Chunk ${i} missing binary data structure`);\n    continue;\n  }\n  \n  const binaryInfo = chunk.binary.data;\n  const jsonInfo = chunk.json;\n  \n  console.log(`Processing chunk ${i}: ${jsonInfo.filename}`);\n  \n  items.push({\n    json: {\n      index: i,\n      filename: jsonInfo.filename,\n      fileExtension: jsonInfo.fileExtension,\n      mimeType: jsonInfo.mimeType,\n      size: jsonInfo.size,\n      sizeInMB: jsonInfo.sizeInMB,\n      originalFile: jsonInfo.originalFile,\n      duration: jsonInfo.duration\n    },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        Buffer.from(binaryInfo.data, 'base64'),\n        jsonInfo.filename,\n        jsonInfo.mimeType\n      )\n    }\n  });\n}\n\nconsole.log(`Successfully created ${items.length} items with binary data`);\n\nif (items.length === 0) {\n  throw new Error('No valid chunks were processed. Check console logs for details.');\n}\n\nreturn items;"
      },
