      "parameters": {
        "jsCode": "// POST /split returns a JSON array; the HTTP Request node emits one item per chunk:\n// { data: { filename, fileExtension, mimeType, size, sizeInMB, originalFile, duration }, binary: \"<base64>\" }\nconst results = [];\n\nfor (const [index, item] of $input.all().entries()) {\n  const { data, binary } = item.json;\n  if (!data || typeof binary !== 'string') {\n    throw new Error(`Item ${index} is not an audio-splitter chunk (expected { data, binary })`);\n  }\n\n  results.push({\n    json: { index, ...data },\n    binary: {\n      data: await this.helpers.prepareBinaryData(\n        Buffer.from(binary, 'base64'),\n        data.filename,\n        data.mimeType\n      ),\n    },\n    pairedItem: { item: index },\n  });\n}\n\nreturn results;"
      },
